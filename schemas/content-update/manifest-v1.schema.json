{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhelobible.com/schemas/content-update/manifest-v1.schema.json",
  "title": "Rhelo Bundled Content Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "update_id",
    "content_version",
    "minimum_schema_version",
    "package_created_at",
    "package_sha256",
    "payload_files",
    "expected_inserted_rows",
    "expected_updated_rows",
    "expected_deleted_rows",
    "affected_static_tables",
    "fts_rebuild",
    "source_ids",
    "licence_ids",
    "attribution_references"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "update_id": {
      "$ref": "#/$defs/stableId"
    },
    "content_version": {
      "type": "integer",
      "minimum": 2
    },
    "minimum_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_schema_version": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "minimum_app_version": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "package_created_at": {
      "type": "string",
      "format": "date-time"
    },
    "package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/payload"
      }
    },
    "expected_inserted_rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "expected_updated_rows": {
      "const": 0
    },
    "expected_deleted_rows": {
      "const": 0
    },
    "affected_static_tables": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/staticTable"
      }
    },
    "fts_rebuild": {
      "type": "array",
      "maxItems": 0
    },
    "source_ids": {
      "$ref": "#/$defs/stableIdArray"
    },
    "licence_ids": {
      "$ref": "#/$defs/stableIdArray"
    },
    "attribution_references": {
      "$ref": "#/$defs/stableIdArray"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "stableIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "staticTable": {
      "enum": [
        "verse_translations",
        "geography_routes",
        "route_points",
        "commentaries",
        "cross_references"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "table",
        "mode",
        "sha256",
        "expected_inserted_rows",
        "expected_updated_rows",
        "expected_deleted_rows"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.jsonl$"
        },
        "table": {
          "$ref": "#/$defs/staticTable"
        },
        "mode": {
          "const": "insert_only"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_inserted_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "expected_updated_rows": {
          "const": 0
        },
        "expected_deleted_rows": {
          "const": 0
        }
      }
    }
  }
}
