{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhelobible.com/schemas/content-update/checksums-v1.schema.json",
  "title": "Rhelo Bundled Content Checksums v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_sha256",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+\\.jsonl$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
